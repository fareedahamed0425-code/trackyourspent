rules_version = "2";
service cloud.firestore {
  match /databases/{database}/documents {
    // User accounts isolation rule: Users can only read and write their own data
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // Strict schema validation for subcollections
      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}

